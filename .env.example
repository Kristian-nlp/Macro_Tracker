# ----------------------------------------------------------------------------
# Macro Tracker environment variables
# Copy to .env.local for local development. Set the same keys in Vercel project
# settings for production. NEVER commit real values.
# ----------------------------------------------------------------------------

# Anthropic Console API key. Server-side ONLY — read in route handlers via
# process.env. Must never appear in a client component or the browser bundle.
ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection string from Neon or Supabase (use the pooled / serverless
# connection string). Server-side only.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Shared password that gates the whole app (checked in middleware + on login).
# Pick something long and random.
APP_PASSWORD=change-me-to-a-long-random-string

# ---- optional: Upstash Redis for a durable cross-instance rate limit ----
# If unset, the app falls back to a per-instance in-memory rate limiter, which
# is enough to stop a leaked URL from running up a large bill in normal use.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
